{
  home = {
    sessionVariables = {
      EDITOR = "nvim";
      BROWSER = "firefox";
      DISPLAY = ":0";
      TerminalEmulator = "foot";
    };
    sessionPath = [
      "$HOME/Applications/scripts"
      "$HOME/.nix-profile/bin"
      "$HOME/.local/bin"
      "$HOME/.npm-global/bin"
    ];
  };
}
